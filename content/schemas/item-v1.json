{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://bridgesat.example/schemas/item-v1.json",
  "title": "BridgeSAT math item v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "schema_version",
    "domain",
    "content_type",
    "target_skill",
    "target_subskill",
    "required_prerequisites",
    "difficulty",
    "prompt",
    "choices",
    "answer_choice_id",
    "misconception_map",
    "hints",
    "worked_explanation",
    "estimated_seconds",
    "source_lineage",
    "license",
    "review_status",
    "reviewers",
    "content_hash",
    "author_metadata"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^math\\.[a-z_]+\\.[0-9]{3}$" },
    "version": { "type": "integer", "minimum": 1 },
    "schema_version": { "const": "v1" },
    "domain": { "const": "math" },
    "content_type": { "const": "question" },
    "target_skill": { "type": "string" },
    "target_subskill": { "type": "string" },
    "required_prerequisites": { "type": "array", "items": { "type": "string" } },
    "difficulty": { "type": "integer", "minimum": 1, "maximum": 5 },
    "prompt": { "type": "string", "minLength": 1 },
    "choices": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-D]$" },
          "text": { "type": "string", "minLength": 1 }
        }
      }
    },
    "answer_choice_id": { "type": "string", "pattern": "^[A-D]$" },
    "misconception_map": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "hints": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["level", "text"],
        "properties": {
          "level": { "type": "integer", "minimum": 1, "maximum": 3 },
          "text": { "type": "string", "minLength": 1 }
        }
      }
    },
    "worked_explanation": { "type": "string", "minLength": 1 },
    "estimated_seconds": { "type": "integer", "minimum": 1 },
    "source_lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "lineage_id", "role"],
      "properties": {
        "source_id": { "type": "string" },
        "lineage_id": { "type": "string" },
        "role": { "const": "concept_source_only" }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" }
      }
    },
    "review_status": { "type": "string", "enum": ["draft", "schema_validated", "educational_review", "license_review", "approved", "published"] },
    "reviewers": { "type": "object" },
    "content_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "author_metadata": { "type": "object" }
  }
}
