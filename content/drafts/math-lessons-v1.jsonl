{"body": "A unit rate expresses a quantity per one unit of another quantity. Set up a proportion so the units match, then solve for the unknown.", "content_hash": "sha256:f30cabfa33bc55d3f4b7082db005e00d0944d3c4a719e4d36a046a3d20711088", "content_type": "micro_lesson", "difficulty": 1, "domain": "math", "estimated_seconds": 120, "id": "math.ratios_percentages.micro_lesson.001", "license": {"id": "bridgesat_original", "independent_answer_verification": true, "name": "BridgeSAT original content", "recorded_authorship": "ai_assisted_bridgesat"}, "required_prerequisites": ["integer_operations"], "review_status": "draft", "reviewers": {}, "schema_version": "v1", "source_lineage": {"lineage_id": "bridgesat-original", "role": "concept_source_only", "source_id": "deepmind_mathematics_dataset"}, "target_skill": "ratios_percentages", "target_subskill": "", "title": "Unit Rates and Proportional Reasoning", "version": 1}
