{"body": "Linear models have the form f(x) = mx + b. The slope m is the rate of change and b is the starting value. Evaluate f(x) by substituting.", "content_hash": "sha256:cc9db1ca1540e00452b9d36d5c410cf39383bbc1a4fc2c12342282605ef639bf", "content_type": "micro_lesson", "difficulty": 1, "domain": "math", "estimated_seconds": 120, "id": "math.functions_models.micro_lesson.001", "license": {"id": "bridgesat_original", "independent_answer_verification": true, "name": "BridgeSAT original content", "recorded_authorship": "ai_assisted_bridgesat"}, "required_prerequisites": ["linear_equations", "integer_operations"], "review_status": "draft", "reviewers": {}, "schema_version": "v1", "source_lineage": {"lineage_id": "bridgesat-original", "role": "concept_source_only", "source_id": "deepmind_mathematics_dataset"}, "target_skill": "functions_models", "target_subskill": "", "title": "Modeling Situations with Functions", "version": 1}
